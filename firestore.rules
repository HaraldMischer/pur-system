rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================================
    // Gemeinsame Hilfsfunktionen
    // ===============================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasProfil() {
      return isAuthenticated() && exists(/databases/$(database)/documents/benutzerprofil/$(request.auth.uid));
    }

    function profil() {
      return get(/databases/$(database)/documents/benutzerprofil/$(request.auth.uid)).data;
    }

    function isMaster() {
      return hasProfil() && profil().aktiv == true && profil().userRole == 'master';
    }

    function isOffice() {
      return hasProfil() && profil().aktiv == true && profil().userRole == 'office';
    }

    function isMitarbeiter() {
      return hasProfil() && profil().aktiv == true && profil().userRole == 'mitarbeiter';
    }

    function isScopedUser() {
      return hasProfil() && profil().aktiv == true && profil().userRole in ['office', 'filiale'];
    }

    function istEigenesProfil(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function darfUnternehmerLesen(unternehmerId) {
      return isScopedUser()
        && profil().zugriffe is map
        && unternehmerId in profil().zugriffe
        && profil().zugriffe[unternehmerId] is map
        && profil().zugriffe[unternehmerId].size() > 0;
    }

    function darfFirmaLesen(unternehmerId, firmaId) {
      return darfUnternehmerLesen(unternehmerId)
        && firmaId in profil().zugriffe[unternehmerId]
        && profil().zugriffe[unternehmerId][firmaId] is list
        && profil().zugriffe[unternehmerId][firmaId].size() > 0;
    }

    function darfFilialeLesen(unternehmerId, firmaId, filialId) {
      return darfFirmaLesen(unternehmerId, firmaId)
        && filialId in profil().zugriffe[unternehmerId][firmaId];
    }

    function darfMitarbeiterFirmaVerwenden(unternehmerId, firmaId) {
      return darfFirmaLesen(unternehmerId, firmaId);
    }

    function darfMitarbeiterLesen(unternehmerId, firmaId) {
      return darfMitarbeiterFirmaVerwenden(unternehmerId, firmaId)
        && (
          profil().userRole == 'office'
          || (
            profil().userRole == 'filiale'
            && resource.data.filialIds is list
            && resource.data.filialIds.hasAny([profil().zugriffe[unternehmerId][firmaId][0]])
          )
        );
    }

    function hatGueltigeMitarbeiterFilialenBeiAnlage(unternehmerId, firmaId) {
      return request.resource.data.filialIds is list
        && request.resource.data.filialIds.size() == request.resource.data.filialIds.toSet().size()
        && request.resource.data.filialIds.hasOnly(profil().zugriffe[unternehmerId][firmaId]);
    }

    function bleibenFremdeMitarbeiterFilialenErhalten(unternehmerId, firmaId) {
      let erlaubteFilialen = profil().zugriffe[unternehmerId][firmaId].toSet();
      let bisherigeFremdeFilialen = resource.data.filialIds.toSet().difference(erlaubteFilialen);
      let neueFremdeFilialen = request.resource.data.filialIds.toSet().difference(erlaubteFilialen);
      return neueFremdeFilialen == bisherigeFremdeFilialen;
    }

    function hatGueltigeMitarbeiterFilialenBeiBearbeitung(unternehmerId, firmaId) {
      return resource.data.filialIds is list
        && request.resource.data.filialIds is list
        && request.resource.data.filialIds.size() == request.resource.data.filialIds.toSet().size()
        && bleibenFremdeMitarbeiterFilialenErhalten(unternehmerId, firmaId);
    }

    function darfMitarbeiterAnlegen(unternehmerId, firmaId) {
      return darfMitarbeiterFirmaVerwenden(unternehmerId, firmaId)
        && !('benutzerUid' in request.resource.data)
        && request.resource.data.rollen is list
        && request.resource.data.rollen.size() > 0
        && request.resource.data.rollen.hasOnly([
          'filialkasse',
          'servicekraft',
          'administrator',
          'kassierer',
          'techniker',
          'dienstplaner'
        ])
        && request.resource.data.erstelltAm == request.time
        && request.resource.data.aktualisiertAm == request.time
        && hatGueltigeMitarbeiterFilialenBeiAnlage(unternehmerId, firmaId)
        && (
          profil().userRole == 'office'
          || profil().zugriffe[unternehmerId][firmaId][0] in request.resource.data.filialIds
        );
    }

    function darfMitarbeiterBearbeiten(unternehmerId, firmaId) {
      return darfMitarbeiterLesen(unternehmerId, firmaId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'person',
          'anzeigename',
          'rollen',
          'filialIds',
          'aktiv',
          'aktualisiertAm'
        ])
        && request.resource.data.rollen is list
        && request.resource.data.rollen.size() > 0
        && request.resource.data.rollen.hasOnly([
          'filialkasse',
          'servicekraft',
          'administrator',
          'kassierer',
          'techniker',
          'dienstplaner'
        ])
        && request.resource.data.aktualisiertAm == request.time
        && hatGueltigeMitarbeiterFilialenBeiBearbeitung(unternehmerId, firmaId)
        && (
          profil().userRole == 'office'
          || profil().zugriffe[unternehmerId][firmaId][0] in request.resource.data.filialIds
        );
    }

    function darfMitarbeiterFirmaLesen(unternehmerId, firmaId) {
      return isMitarbeiter()
        && profil().zugriffe is map
        && unternehmerId in profil().zugriffe
        && profil().zugriffe[unternehmerId] is map
        && firmaId in profil().zugriffe[unternehmerId]
        && profil().zugriffe[unternehmerId][firmaId] is list;
    }

    function darfMitarbeiterUnternehmerLesen(unternehmerId) {
      return isMitarbeiter()
        && profil().zugriffe is map
        && unternehmerId in profil().zugriffe
        && profil().zugriffe[unternehmerId] is map
        && profil().zugriffe[unternehmerId].size() > 0;
    }

    // ===============================================================================
    // 1. Fachliche Daten der Unternehmensstruktur
    // ===============================================================================

    match /unternehmer/{unternehmerId} {
      allow read, create, update: if isMaster();
      allow read: if darfUnternehmerLesen(unternehmerId);
      allow read: if darfMitarbeiterUnternehmerLesen(unternehmerId);

      match /firma/{firmaId} {
        allow read, create, update: if isMaster();
        allow read: if darfFirmaLesen(unternehmerId, firmaId);
        allow read: if darfMitarbeiterFirmaLesen(unternehmerId, firmaId);
        allow update: if isOffice() && darfFirmaLesen(unternehmerId, firmaId);

        match /filiale/{filialId} {
          allow read, create, update: if isMaster();
          allow read: if darfFilialeLesen(unternehmerId, firmaId, filialId);
          allow read: if darfMitarbeiterFirmaLesen(unternehmerId, firmaId);
          allow update: if isOffice() && darfFilialeLesen(unternehmerId, firmaId, filialId);
        }

        match /filiale/{filialId}/{document=**} {
          allow read, create, update: if isMaster();
          allow read: if darfFilialeLesen(unternehmerId, firmaId, filialId);
        }

        match /mitarbeiter/{mitarbeiterId} {
          allow read, create, update: if isMaster();
          allow delete: if isMaster() && resource.data.get('benutzerUid', null) == null;
          allow read: if isOffice() && darfFirmaLesen(unternehmerId, firmaId);
          allow read: if profil().userRole == 'filiale'
            && darfFirmaLesen(unternehmerId, firmaId);
          allow read: if darfMitarbeiterFirmaLesen(unternehmerId, firmaId);
          allow create: if darfMitarbeiterAnlegen(unternehmerId, firmaId);
          allow update: if darfMitarbeiterBearbeiten(unternehmerId, firmaId);
        }

      }
    }

    // ===============================================================================
    // 2. Benutzerprofile clientseitig ausschließlich lesen
    // ===============================================================================

    match /benutzerprofil/{uid} {
      allow read: if isMaster() || istEigenesProfil(uid);

      match /{subcollection}/{document=**} {
        allow read, write: if isMaster();
      }
    }

    // ===============================================================================
    // 3. Status der Datenmigration
    // ===============================================================================

    match /systemMigrationen/{purCustomerId} {
      allow read, create, update: if isMaster();

      match /datenbereiche/{datenbereichId} {
        allow read, create, update: if isMaster();
      }
    }

    // ===============================================================================
    // 4. Konten der Altanwendung ohne Pur-System-Benutzerprofil
    // ===============================================================================

    match /purCustomers/{document=**} {
      allow read: if isMaster() || (isAuthenticated() && !hasProfil());
      allow write: if isAuthenticated() && !hasProfil();
    }

    match /purUser/{document=**} {
      allow read, write: if isAuthenticated() && !hasProfil();
    }
  }
}
