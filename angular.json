{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "pur-office": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.scss"]
          },
          "configurations": {
            "office": {
              "outputPath": "dist/pur-office",
              "serviceWorker": "ngsw-config.json",
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public",
                  "ignore": ["manifests/**"]
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.6MB",
                  "maximumError": "1.7MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.office-prod.ts"
                }
              ]
            },
            "master": {
              "outputPath": "dist/pur-master",
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public",
                  "ignore": ["manifest.webmanifest", "manifests/**"]
                },
                {
                  "glob": "manifest.webmanifest",
                  "input": "public/manifests/pur-master",
                  "output": "/"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.master-prod.ts"
                }
              ]
            },
            "filiale": {
              "outputPath": "dist/pur-filiale",
              "serviceWorker": "ngsw-config.json",
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public",
                  "ignore": ["manifest.webmanifest", "manifests/**"]
                },
                {
                  "glob": "manifest.webmanifest",
                  "input": "public/manifests/pur-filiale",
                  "output": "/"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.filiale-prod.ts"
                }
              ]
            },
            "mitarbeiter": {
              "outputPath": "dist/pur-mitarbeiter",
              "serviceWorker": "ngsw-config.json",
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public",
                  "ignore": ["manifest.webmanifest", "manifests/**"]
                },
                {
                  "glob": "manifest.webmanifest",
                  "input": "public/manifests/pur-mitarbeiter",
                  "output": "/"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.mitarbeiter-prod.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "office"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "office": {
              "buildTarget": "pur-office:build:office"
            },
            "development": {
              "buildTarget": "pur-office:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "buildTarget": "pur-office:build:development"
          }
        }
      }
    }
  }
}
